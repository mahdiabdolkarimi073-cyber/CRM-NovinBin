// Prisma schema for Novin Bin (نوین بین) ERP+CRM
// Database: PostgreSQL — single database: "novinbin"
// All users, roles, and data live in this one database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  profile      Profile?
}

// ============ CORE / TENANCY ============

model Organization {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  code                String              @unique
  plan                String              @default("starter")
  ownerId             String?             @db.Uuid
  active              Boolean             @default(true)
  maxUsers            Int                 @default(10)
  subscriptionStatus  String              @default("trial")
  renewalDate         DateTime?
  settings            Json                @default("{}")
  createdAt           DateTime            @default(now())
  branches            Branch[]
  departments         Department[]
  teams               Team[]
  profiles            Profile[]
  customers           Customer[]
  leads               Lead[]
  opportunities      Opportunity[]
  tasks               Task[]
  productCategories   ProductCategory[]
  products            Product[]
  orders              Order[]
  invoices            Invoice[]
  meetings            Meeting[]
  tickets             Ticket[]
  notifications       Notification[]
  loyaltyTransactions LoyaltyTransaction[]
  warehouses          Warehouse[]
  stockMovements      StockMovement[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  employees           Employee[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  bankAccounts        BankAccount[]
  cashFunds           CashFund[]
  fundTransfers       FundTransfer[]
  cheques             Cheque[]
  payments            Payment[]
  expenseClaims       ExpenseClaim[]
  costCenters         CostCenter[]
  fiscalYears         FiscalYear[]
  fiscalPeriods       FiscalPeriod[]
  subscriptions       Subscription[]
  tenantModules       TenantModule[]
  usageRecords        UsageRecord[]
  billingInvoices     BillingInvoice[]
  auditLogs           AuditLog[]
  registrationRequests RegistrationRequest[]
  dailyWorkReports    DailyWorkReport[]
  monthlyWorkReports  MonthlyWorkReport[]
  customerAssignments CustomerAssignment[]
  staffContracts      StaffContract[]
  preInvoices         PreInvoice[]
  salesReturns        SalesReturn[]
  receipts            Receipt[]
  callLogs            CallLog[]
  demos               Demo[]
  academyStudents     AcademyStudent[]
  academyEnrollments  AcademyEnrollment[]
  pagePermissions     PagePermission[]
  userManagers        UserManager[]
  customerChatMessages CustomerChatMessage[]
  meetingAssignments  MeetingAssignment[]
  stockTransfers      StockTransfer[]
  customerInteractions CustomerInteraction[]
  customerSegments    CustomerSegment[]
  loyaltyRewards      LoyaltyReward[]
  loyaltyRedemptions  LoyaltyRedemption[]
  demoActivities      DemoActivity[]
  approvalRequests    ApprovalRequest[]
  documents           Document[]
  knowledgeArticles   KnowledgeArticle[]
  goals               Goal[]
  kpiRecords          KpiRecord[]

  @@map("organizations")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  name      String
  address   String?
  phone     String?
  managerId String?  @db.Uuid
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("branches")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  name      String
  headId    String?  @db.Uuid
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams     Team[]

  @@map("departments")
}

model Team {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?   @db.Uuid
  departmentId  String?  @db.Uuid
  name          String
  leaderId      String?  @db.Uuid
  createdAt     DateTime @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamMembers   TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @db.Uuid
  profileId String   @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, profileId])
  @@map("team_members")
}

model Profile {
  id           String   @id @db.Uuid
  orgId        String?  @db.Uuid
  userType     String   @default("staff") // staff | customer
  role         String   @default("personnel") // owner | super_admin | admin | personnel
  firstName    String?
  lastName     String?
  phone        String?
  avatarUrl    String?
  position     String?
  departmentId String?  @db.Uuid
  customerId   String?  @db.Uuid
  assignedPages String[]
  birthDate    DateTime?
  lastSeenAt   DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============ CRM ============

model Customer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?   @db.Uuid
  type          String   @default("individual")
  firstName     String?
  lastName      String?
  companyName   String?
  nationalId    String?
  email         String?
  phone         String?
  mobile        String?
  address       String?
  city          String?
  province      String?
  postalCode    String?
  birthDate     DateTime?
  socialLinks   Json     @default("{}")
  score         Int      @default(0)
  level         String   @default("bronze")
  walletBalance BigInt   @default(0)
  loyaltyPoints Int      @default(0)
  source        String?
  assignedTo    String?  @db.Uuid
  notes         String?
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orders        Order[]
  invoices      Invoice[]
  tickets       Ticket[]
  loyaltyTransactions LoyaltyTransaction[]
  leads         Lead[]
  customerAssignments CustomerAssignment[]
  chatMessages  CustomerChatMessage[]
  interactions  CustomerInteraction[]
  redemptions   LoyaltyRedemption[]
  segmentMembers CustomerSegmentMember[]

  @@map("customers")
}

model Lead {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?    @db.Uuid
  name          String
  company       String?
  phone         String?
  email         String?
  source        String?
  score         Int       @default(0)
  status        String    @default("new")
  assignedTo    String?   @db.Uuid
  customerId    String?   @db.Uuid
  notes         String?
  nextFollowUp  DateTime?
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model Opportunity {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?    @db.Uuid
  title         String
  customerId    String?   @db.Uuid
  leadId        String?   @db.Uuid
  amount        BigInt    @default(0)
  probability   Int       @default(0)
  stage         String    @default("new_lead")
  assignedTo    String?   @db.Uuid
  expectedClose DateTime?
  description   String?
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}

// ============ TASKS ============

model Task {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?   @db.Uuid
  title       String
  description String?
  assignedTo  String?  @db.Uuid
  createdBy   String   @db.Uuid
  teamId      String?  @db.Uuid
  customerId  String?  @db.Uuid
  priority    String   @default("medium")
  status      String   @default("new")
  progress    Int      @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  referredDate DateTime?
  completedAt DateTime?
  checklist   Json     @default("[]")
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  comments    TaskComment[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @db.Uuid
  profileId String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

// ============ SALES ============

model ProductCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products  Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?   @db.Uuid
  name        String
  type        String   @default("product")
  sku         String?
  barcode     String?
  categoryId  String?  @db.Uuid
  brand       String?
  price       BigInt   @default(0)
  cost        BigInt   @default(0)
  taxRate     Int      @default(0)
  discount    Int      @default(0)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  unit        String?
  weight      Float    @default(0)
  imageUrl    String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  preInvoiceItems PreInvoiceItem[]
  returnItems  ReturnItem[]

  @@map("products")
}

model Order {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  number    String?
  customerId String? @db.Uuid
  status    String   @default("registered")
  subtotal  BigInt   @default(0)
  discount  BigInt   @default(0)
  tax       BigInt   @default(0)
  total     BigInt   @default(0)
  notes     String?
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer  Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @db.Uuid
  productId String?  @db.Uuid
  name      String
  qty       Int      @default(1)
  price     BigInt   @default(0)
  discount  BigInt   @default(0)
  total     BigInt   @default(0)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Invoice {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?    @db.Uuid
  number    String
  customerId String?  @db.Uuid
  orderId   String?   @db.Uuid
  amount    BigInt    @default(0)
  paid      BigInt    @default(0)
  status    String    @default("unpaid")
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer  Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

// ============ MEETINGS ============

model Meeting {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String?    @db.Uuid
  title      String
  topic      String?
  agenda     String?
  date       DateTime  @default(now())
  endTime    DateTime?
  location   String?
  onlineLink String?
  notes      String?
  minutes    String?
  outcome    String?
  createdBy  String    @db.Uuid
  createdAt  DateTime  @default(now())
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  assignments  MeetingAssignment[]

  @@map("meetings")
}

model MeetingParticipant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId  String   @db.Uuid
  profileId  String   @db.Uuid
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, profileId])
  @@map("meeting_participants")
}

// ============ TICKETS ============

model Ticket {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?    @db.Uuid
  subject     String
  description String?
  customerId  String?   @db.Uuid
  priority    String    @default("medium")
  status      String    @default("open")
  channel     String    @default("internal")
  assignedTo  String?   @db.Uuid
  slaDeadline DateTime?
  createdBy   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("tickets")
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  profileId String   @db.Uuid
  title     String
  body      String?
  type      String   @default("info")
  priority  String   @default("normal")
  read      Boolean  @default(false)
  readAt    DateTime?
  link      String?
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============ LOYALTY ============

model LoyaltyTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?   @db.Uuid
  customerId  String   @db.Uuid
  points      Int      @default(0)
  type        String   @default("earn")
  description String?
  createdAt   DateTime @default(now())
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}

// ============ ACCOUNTING ============

model Account {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String?   @db.Uuid
  code           String
  name           String
  type           String
  parentId       String?  @db.Uuid
  balance        BigInt   @default(0)
  openingBalance BigInt   @default(0)
  isGroup        Boolean  @default(false)
  costCenterId   String?  @db.Uuid
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  org            Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model JournalEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String?   @db.Uuid
  number         String
  date           DateTime @default(now())
  description    String?
  status         String   @default("draft")
  fiscalYearId   String?  @db.Uuid
  periodId       String?  @db.Uuid
  costCenterId   String?  @db.Uuid
  reversedBy     String?  @db.Uuid
  referenceType  String   @default("manual")
  referenceId    String?  @db.Uuid
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now())
  org            Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines          JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String   @db.Uuid
  accountId      String   @db.Uuid
  debit          BigInt   @default(0)
  credit         BigInt   @default(0)
  description    String?
  costCenterId   String?  @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@map("journal_lines")
}

model FiscalYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("open")
  closedBy  String?  @db.Uuid
  closedAt  DateTime?
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periods   FiscalPeriod[]

  @@map("fiscal_years")
}

model FiscalPeriod {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?   @db.Uuid
  fiscalYearId  String   @db.Uuid
  name          String
  periodNumber  Int
  startDate     DateTime
  endDate       DateTime
  status        String   @default("open")
  createdAt     DateTime @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fiscalYear    FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@map("fiscal_periods")
}

model CostCenter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  code      String
  name      String
  parentId  String?  @db.Uuid
  managerId String?  @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("cost_centers")
}

model BankAccount {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String?   @db.Uuid
  name       String
  bankName   String
  accountNo  String
  balance    BigInt   @default(0)
  branchName String?
  cardNumber String?
  iban       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model CashFund {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  name      String
  type      String   @default("cash")
  balance   BigInt   @default(0)
  managerId String?  @db.Uuid
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("cash_funds")
}

model FundTransfer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?   @db.Uuid
  number      String
  fromType    String
  fromId      String   @db.Uuid
  toType      String
  toId        String   @db.Uuid
  amount      BigInt   @default(0)
  date        DateTime @default(now())
  description String?
  reference   String?
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("fund_transfers")
}

model Cheque {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String?    @db.Uuid
  type       String
  number     String
  amount     BigInt    @default(0)
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  status     String    @default("pending")
  bankName   String?
  bankAccountId String? @db.Uuid
  cashFundId String?   @db.Uuid
  customerId String?   @db.Uuid
  payee      String?
  clearedDate DateTime?
  referenceType String?
  notes      String?
  createdAt  DateTime  @default(now())
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("cheques")
}

model Payment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String?   @db.Uuid
  number       String
  customerId   String?  @db.Uuid
  invoiceId    String?  @db.Uuid
  amount       BigInt   @default(0)
  method       String   @default("cash")
  cashMethod   String?
  bankName     String?
  chequeNumber String?
  branchCode   String?
  trackingNumber String?
  reminder     String?
  payerType    String?
  payerName    String?
  receivedDate DateTime?
  reference    String?
  bankAccountId String? @db.Uuid
  cashFundId   String?  @db.Uuid
  chequeId     String?  @db.Uuid
  date         DateTime @default(now())
  status       String   @default("completed")
  description  String?
  createdBy    String   @db.Uuid
  createdAt    DateTime @default(now())
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ExpenseClaim {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String?   @db.Uuid
  number        String
  employeeId    String   @db.Uuid
  title         String
  totalAmount   BigInt   @default(0)
  status        String   @default("draft")
  costCenterId  String?  @db.Uuid
  submittedAt   DateTime?
  approvedBy    String?  @db.Uuid
  approvedAt    DateTime?
  rejectedReason String?
  paymentDate   DateTime?
  cashFundId    String?  @db.Uuid
  bankAccountId String?  @db.Uuid
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items         ExpenseClaimItem[]

  @@map("expense_claims")
}

model ExpenseClaimItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String?   @db.Uuid
  expenseClaimId  String   @db.Uuid
  accountId       String?  @db.Uuid
  description     String?
  amount          BigInt   @default(0)
  date            DateTime @default(now())
  expenseClaim    ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)

  @@map("expense_claim_items")
}

// ============ INVENTORY ============

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?   @db.Uuid
  name      String
  address   String?
  manager   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("warehouses")
}

model StockMovement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String?   @db.Uuid
  productId  String?  @db.Uuid
  warehouseId String? @db.Uuid
  type       String
  qty        Int      @default(0)
  reason     String?
  refType    String?
  refId      String?  @db.Uuid
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())
