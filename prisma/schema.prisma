// ============ PAYMENT ANNOUNCEMENTS (اعلامیه‌های پرداخت) ============

model PaymentAnnouncement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String?   @db.Uuid
  type            String   // نوع اعلامیه
  counterparty    String   // طرف مقابل (super_admin | admin | personnel | customer | contact_party)
  counterpartyId  String?  @db.Uuid // شناسه طرف مقابل در صورت انتخاب
  date            DateTime @default(now()) // تاریخ اعلامیه
  bankAccountId   String?  @db.Uuid // حساب بانکی
  bankFee         BigInt   @default(0) // کارمزد بانکی
  amount          BigInt   @default(0) // مبلغ پرداخت
  description     String?  // توضیحات
  status          String   @default("draft") // draft | confirmed | cancelled
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  org             Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  withdrawals     WithdrawalAnnouncement[]
  cheques         MyCheque[]

  @@map("payment_announcements")
}

model WithdrawalAnnouncement {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String?   @db.Uuid
  paymentAnnouncementId String   @db.Uuid
  transferNumber        String   // شماره حواله پرداخت
  date                  DateTime @default(now()) // تاریخ
  amount                BigInt   @default(0) // مبلغ
  bankAccountId         String?  @db.Uuid // حساب بانکی
  bankFee               BigInt   @default(0) // کارمزد بانکی (عدد فقط)
  description           String?  // توضیحات
  createdBy             String   @db.Uuid
  createdAt             DateTime @default(now())
  org                   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentAnnouncement   PaymentAnnouncement @relation(fields: [paymentAnnouncementId], references: [id], onDelete: Cascade)
  bankAccount           BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@map("withdrawal_announcements")
}

model MyCheque {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String?   @db.Uuid
  paymentAnnouncementId String   @db.Uuid
  bankAccountId         String?  @db.Uuid // حساب بانکی چک
  chequeNumber          String   // شماره چک
  sayadiNumber          String?  // شماره صیادی چک
  amount                BigInt   @default(0) // مبلغ
  date                  DateTime @default(now()) // تاریخ
