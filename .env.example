
# Database
DATABASE_URL="postgresql://postgres:123456@localhost:5432/novinbin"

# App Configuration
NEXT_PUBLIC_APP_NAME=نوین بین
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
JWT_SECRET="your-jwt-secret-key-change-in-production"

# Mellat Payment Gateway (BehPardakht Shaparak) - Academy
# شماره ترمینال دریافتی از شرکت بهپرداخت ملت (عدد عددی مانند 1234567)
MELLAT_TERMINAL_ID=
# نام کاربری پذیرنده در بهپرداخت ملت
MELLAT_USERNAME=
# کلمه عبور پذیرنده در بهپرداخت ملت
MELLAT_PASSWORD=
# آدرس دامنه اصلی سامانه جهت ارجاع برگشت از شاپرک (بدون اسلش پایانی)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

